MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/revbookmyshow
# Optional: override DNS servers when SRV lookups are blocked by Docker, VPN, or corporate DNS.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=your_super_secret_key_here
FRONTEND_URL=http://localhost:5173,https://your-cloudfront-domain.cloudfront.net
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-cloudfront-domain.cloudfront.net
MOVIE_NOTIFY_LAMBDA_URL=https://your-lambda-function-url.lambda-url.region.on.aws/
MOVIE_NOTIFY_LAMBDA_API_KEY=optional-if-you-protect-the-lambda-url
NODE_ENV=production
RAZORPAY_KEY_ID=rzp_test_yourKeyIDHere
RAZORPAY_KEY_SECRET=yourKeySecretHere

# Email SMTP Notification Setup (Gmail / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
FROM_EMAIL=your_email@gmail.com